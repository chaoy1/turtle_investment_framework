# Market data uses AKShare and Yahoo Finance and does not require a token.

# OpenAI API for an API-hosted GPT agent.
# Codex Desktop / CLI users authenticated with ChatGPT can leave this unset.
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Optional: API base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional GPT runtime settings. The agent should use the Responses API.
# OPENAI_MODEL=gpt-5.6
# OPENAI_REASONING_EFFORT=high
